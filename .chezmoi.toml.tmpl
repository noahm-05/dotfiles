{{- /* Defaults keep non-interactive runs working: chezmoi init --promptBool gui=true */ -}}
{{- $gui := promptBoolOnce . "gui" "GUI machine (Ghostty, tinty, font)" false -}}
{{- $name := promptStringOnce . "name" "Git name" "" -}}
{{- $email := promptStringOnce . "email" "Git email" "" -}}
[data]
    gui = {{ $gui }}
    name = {{ $name | quote }}
    email = {{ $email | quote }}
